manifest {
    name            = 'euk-bot'
    description     = 'Metatranscriptome processing: QC, rRNA removal, assembly and reference-based mapping'
    author          = 'Sarah Hu'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // Input / output
    input               = null        // CSV: sample,fastq_1,fastq_2
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    save_trimmed        = false       // publish fastp-trimmed reads
    save_non_rrna       = false       // publish rRNA-depleted reads

    // Branches
    run_assembly        = true
    run_reference       = true

    // QC / rRNA removal
    skip_rrna_removal   = false
    sortmerna_db        = null        // FASTA or glob, e.g. '/path/rRNA_databases/*.fasta'

    // Assembly branch
    assembler           = 'rnaspades' // 'rnaspades' | 'megahit'
    cdhit_identity      = 0.98
    transdecoder_min_len = 100        // minimum ORF length (aa)
    eggnog_data_dir     = null        // optional; enables eggNOG-mapper

    // Reference (and annotation) DIAMOND database
    reference_dmnd      = null        // e.g. MarFERReT / EukProt / PhyloDB .dmnd
    reference_taxonomy  = null        // optional TSV with header; first column = reference protein ID
    diamond_evalue      = 1e-5

    // SLURM
    slurm_account       = null
    slurm_queue         = null
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    slurm { includeConfig 'conf/slurm.config' }
    conda {
        conda.enabled = true
        conda.channels = ["conda-forge", "bioconda"]
        conda.cacheDir = System.getenv("NXF_CONDA_CACHEDIR") ?: "${projectDir}/.conda_envs"
    }
    mamba {
        conda.enabled  = true
        conda.channels = ["conda-forge", "bioconda"]
        conda.useMamba = true
        conda.cacheDir = System.getenv("NXF_CONDA_CACHEDIR") ?: "${projectDir}/.conda_envs"
    }
    test  { includeConfig 'conf/test.config' }
}

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.html" }
