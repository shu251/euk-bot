manifest {
    name            = 'euk-bot'
    description     = 'Metatranscriptome processing: QC, rRNA removal, assembly and reference-based mapping'
    author          = 'Sarah Hu'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // Input / output
    input               = null        // CSV: sample,fastq_1,fastq_2
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    save_trimmed        = false       // publish fastp-trimmed reads
    save_non_rrna       = false       // publish rRNA-depleted reads
    save_rrna           = true        // publish the rRNA reads RiboDetector removed (for 18S/PR2 analysis later)

    // Branches
    run_assembly        = true
    run_reference       = true

    // QC / rRNA removal
    skip_rrna_removal   = false
    ribodetector_read_len  = 150      // sequencing read length (RiboDetector -l)
    ribodetector_chunk_size = 240     // x1024 reads loaded at once; keep a multiple of cpus, lower if out of memory

    // Pre-assembly read profiling (read_profile.tsv, suggested co-assembly groups)
    run_read_profiling  = false
    stop_after_profiling = false      // run QC + profiling only, to choose groups before assembling
    profile_group_similarity = 0.5    // sourmash similarity cutoff for suggested groups; tune from the matrix
    strand_check_dmnd   = null        // protein .dmnd for strandedness (default: --reference_dmnd), e.g. eggnog_proteins.dmnd
    strand_check_reads  = 200000      // R1 reads subsampled per sample for strandedness
    kaiju_db            = null        // dir with a Kaiju *.fmi + nodes.dmp + names.dmp; Kaiju skipped if unset

    // Assembly branch
    assemblers            = 'rnaspades,megahit'   // per-sample assemblers (comma-separated)
    coassembly_assemblers = 'megahit'             // for samplesheet groups; '' turns co-assembly off
    cluster_identity    = 0.98        // MMseqs2 linclust: min nucleotide identity to merge contigs
    cluster_coverage    = 0.9         // fraction of a contig the cluster representative must cover
    run_assembly_qc     = false       // per-assembly contig stats, read mapping rate, BUSCO -> assembly_qc.tsv
    busco_db_dir        = null        // BUSCO download dir (from download_busco.sbatch); BUSCO skipped if unset
    busco_lineages      = 'eukaryota_odb12'   // comma-separated BUSCO lineages
    transdecoder_min_len = 100        // minimum ORF length (aa)
    eggnog_data_dir     = null        // optional; enables eggNOG-mapper

    // Reference (and annotation) DIAMOND database
    reference_dmnd      = null        // e.g. MarFERReT / EukProt / PhyloDB .dmnd
    reference_taxonomy  = null        // optional TSV with header; first column = reference protein ID
    diamond_evalue      = 1e-5

    // SLURM
    slurm_account       = null
    slurm_queue         = null
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    slurm { includeConfig 'conf/slurm.config' }
    conda {
        conda.enabled = true
        conda.channels = ["conda-forge", "bioconda"]
        conda.createOptions = "--override-channels"   // skip Anaconda defaults (ToS-gated); no strict priority, it hides bioconda builds
        conda.cacheDir = System.getenv("NXF_CONDA_CACHEDIR") ?: "${projectDir}/.conda_envs"
    }
    mamba {
        conda.enabled  = true
        conda.channels = ["conda-forge", "bioconda"]
        conda.createOptions = "--override-channels"   // skip Anaconda defaults (ToS-gated); no strict priority, it hides bioconda builds
        conda.useMamba = true
        conda.cacheDir = System.getenv("NXF_CONDA_CACHEDIR") ?: "${projectDir}/.conda_envs"
    }
    singularity {
        // One image file per tool (vs thousands of files per conda env); same tool versions as the conda envs.
        // Singularity is the only container runtime allowed on Grace (FASTER also has it).
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv("NXF_SINGULARITY_CACHEDIR") ?: "${projectDir}/.singularity_images"
        singularity.pullTimeout = '2h'   // large images (eggNOG-mapper, SPAdes) take a while to convert
        conda.enabled          = false
    }
    test  { includeConfig 'conf/test.config' }
}

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.html" }
