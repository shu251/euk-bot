// Tiny dataset for wiring checks:  nextflow run main.nf -profile test -stub-run
params {
    input          = "${projectDir}/tests/samplesheet_test.csv"
    outdir         = 'results_test'
    reference_dmnd = "${projectDir}/tests/data/reference_test.dmnd"
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
