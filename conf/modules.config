// Where each process publishes its outputs (kept here so modules stay location-agnostic).
process {
    withName: 'CAT_FASTQ' {
        publishDir = [enabled: false]
    }
    withName: 'FASTQC_RAW' {
        publishDir = [path: { "${params.outdir}/qc/fastqc_raw" }, mode: params.publish_dir_mode]
    }
    withName: 'FASTP' {
        publishDir = [
            [path: { "${params.outdir}/qc/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html}'],
            [path: { "${params.outdir}/reads/trimmed" }, mode: params.publish_dir_mode, pattern: '*.fq.gz', enabled: params.save_trimmed]
        ]
    }
    withName: 'BBDUK' {
        publishDir = [path: { "${params.outdir}/qc/bbduk" }, mode: params.publish_dir_mode, pattern: '*.{log,tsv,txt}']
    }
    withName: 'BBNORM' {
        publishDir = [
            [path: { "${params.outdir}/qc/bbnorm" }, mode: params.publish_dir_mode, pattern: '*.{log,tsv}'],
            [path: { "${params.outdir}/reads/normalized" }, mode: params.publish_dir_mode, pattern: '*.fq.gz', enabled: params.save_normalized]
        ]
    }
    withName: 'FASTQC_CLEAN|FASTQC_NORM' {
        publishDir = [path: { "${params.outdir}/qc/fastqc_clean" }, mode: params.publish_dir_mode]
    }
    withName: 'RIBODETECTOR' {
        publishDir = [
            [path: { "${params.outdir}/qc/ribodetector" }, mode: params.publish_dir_mode, pattern: '*.{log,tsv}'],
            [path: { "${params.outdir}/reads/non_rRNA" }, mode: params.publish_dir_mode, pattern: '*_non_rRNA_*.fq.gz', enabled: params.save_non_rrna],
            [path: { "${params.outdir}/reads/rRNA" }, mode: params.publish_dir_mode, pattern: '*.rRNA_*.fq.gz', enabled: params.save_rrna]
        ]
    }
    withName: 'SOURMASH_SKETCH' {
        publishDir = [enabled: false]
    }
    withName: 'SOURMASH_COMPARE|NONPAREIL|STRANDEDNESS|KAIJU|READ_PROFILE_SUMMARY' {
        publishDir = [path: { "${params.outdir}/qc/read_profile" }, mode: params.publish_dir_mode]
    }
    withName: 'QC_SUMMARY' {
        publishDir = [path: { "${params.outdir}/qc" }, mode: params.publish_dir_mode]
    }
    withName: 'MULTIQC_RAW|MULTIQC_CLEAN' {
        publishDir = [path: { "${params.outdir}/qc/multiqc" }, mode: params.publish_dir_mode]
    }

    // Assembly branch
    withName: 'RNASPADES|MEGAHIT' {
        publishDir = [path: { "${params.outdir}/assembly/contigs" }, mode: params.publish_dir_mode]
    }
    withName: 'SEQKIT_STATS|ASSEMBLY_MAPRATE|BUSCO|ASSEMBLY_QC_SUMMARY' {
        publishDir = [path: { "${params.outdir}/assembly/qc" }, mode: params.publish_dir_mode]
    }
    withName: 'MMSEQS_LINCLUST' {
        publishDir = [path: { "${params.outdir}/assembly/clustered" }, mode: params.publish_dir_mode]
    }
    withName: 'TRANSDECODER' {
        publishDir = [path: { "${params.outdir}/assembly/transdecoder" }, mode: params.publish_dir_mode]
    }
    withName: 'METAEUK' {
        publishDir = [path: { "${params.outdir}/assembly/metaeuk" }, mode: params.publish_dir_mode]
    }
    withName: 'DIAMOND_BLASTP|EGGNOG_MAPPER' {
        publishDir = [path: { "${params.outdir}/assembly/annotation" }, mode: params.publish_dir_mode]
    }
    withName: 'SALMON_INDEX' {
        publishDir = [enabled: false]
    }
    withName: 'SALMON_QUANT' {
        publishDir = [path: { "${params.outdir}/assembly/salmon" }, mode: params.publish_dir_mode]
    }
    withName: 'MERGE_SALMON' {
        publishDir = [path: { "${params.outdir}/assembly/tables" }, mode: params.publish_dir_mode]
    }

    // Reference branch
    withName: 'DIAMOND_BLASTX' {
        publishDir = [path: { "${params.outdir}/reference/diamond_blastx" }, mode: params.publish_dir_mode]
    }
    withName: 'SUMMARIZE_HITS' {
        publishDir = [path: { "${params.outdir}/reference/tables" }, mode: params.publish_dir_mode]
    }
}
