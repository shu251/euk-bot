// SLURM executor. Pass --slurm_account / --slurm_queue on the command line or in a params file.
// resourceLimits caps any request (including retries) to what a single node offers;
// the values below assume a 48-core / ~360 GB node (e.g. TAMU Grace) -- adjust to your cluster.
// Partition is picked per task from its (retry-scaled) request unless --slurm_queue forces one.
// Grace walltime caps assumed: short 2 h, medium 1 d, long 7 d; bigmem for > 360 GB -- confirm with the partition listing.
process {
    executor       = 'slurm'
    queue          = {
        params.slurm_queue ?: (
            task.memory > 360.GB ? 'bigmem' :
            task.time  <= 2.h    ? 'short'  :
            task.time  <= 24.h   ? 'medium' : 'long'
        )
    }
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
    resourceLimits = [cpus: 48, memory: 360.GB, time: 168.h]
}

executor {
    queueSize       = 50
    submitRateLimit = '20/1min'
    pollInterval    = '1 min'
}
